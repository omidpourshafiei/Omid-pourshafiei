  <meta property="og:locale" content="fa_IR">

  <style>
    :root { --bg:#f6f7f9; --card:#fff; --text:#1d2430; --muted:#667085; --border:#e4e7ec; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font-family:Tahoma, Arial, sans-serif; line-height:1.9; }
    .container { width:min(900px, 92%); margin:auto; }
    header { padding:56px 0 28px; }
    .badge { display:inline-block; padding:6px 12px; border:1px solid var(--border); border-radius:999px; background:#fff; color:var(--muted); font-size:14px; }
    h1 { font-size:clamp(30px,5vw,48px); margin:18px 0 8px; }
    h2 { margin-top:0; font-size:24px; }
    .lead { font-size:19px; color:var(--muted); max-width:760px; }
    main { padding-bottom:50px; }
    section { background:var(--card); border:1px solid var(--border); border-radius:18px; padding:28px; margin:18px 0; }
    ul { padding-right:22px; }
    .info { display:grid; gap:12px; }
    .row { padding:14px 16px; border:1px solid var(--border); border-radius:12px; }
    .label { display:block; color:var(--muted); font-size:13px; margin-bottom:3px; }
    footer { color:var(--muted); text-align:center; padding:28px 0 45px; font-size:13px; }
  </style>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "امید پورشفیعی",
    "jobTitle": "واردکننده و عمده‌فروش ساعت",
    "worksFor": {
      "@type": "Organization",
      "name": "فعالیت تجاری ساعت"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "تهران",
      "addressCountry": "IR",
      "streetAddress": "بازار بزرگ، خیابان پانزده خرداد، پاساژ نیکپور، طبقه سوم، پلاک ۳۵، واحد ۳"
    }
  }
  </script>
</head>

<body>
  <header class="container">
